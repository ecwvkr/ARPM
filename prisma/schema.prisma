generator client {
  provider        = "prisma-client"
  output          = "../lib/generated/prisma"
  // relationJoins: include를 관계별 개별 쿼리 대신 LATERAL JOIN 한 번으로 처리한다.
  // 서버 함수와 DB가 같은 리전이라도 왕복 횟수가 줄면 그만큼 응답이 빨라진다.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  phone               String?
  avatarUrl           String?
  passwordHash        String
  isSuperAdmin        Boolean   @default(false)
  isActive            Boolean   @default(true) // false = 비활성화(퇴사 등) — 로그인 불가, 참여자 선택 목록에서 제외
  accentColor         String?
  createdAt           DateTime  @default(now())
  lastDeadlineCheckAt DateTime? // 마감 임박/지연 알림 점검을 마지막으로 실행한 시각(대시보드 로드마다 재점검하지 않기 위한 쓰로틀)

  ownedPartners        Partner[]          @relation("PartnerOwner")
  partnerMemberships   PartnerMember[]
  hiddenPartners       PartnerHide[] // 개인별 대시보드 숨김 (D2)
  pinnedPartners       PartnerPin[] // 개인별 대시보드 즐겨찾기 고정
  pinnedProjects       ProjectPin[] // 개인별 프로젝트 카드 상단 고정
  chatMessages         ChatMessage[]
  chatReads            ChatRead[]
  chatRoomMemberships  ChatRoomMember[]
  createdChatRooms     ChatRoom[]         @relation("ChatRoomCreator")
  chatReactions        ChatReaction[]
  pushSubscriptions    PushSubscription[]
  masteredProjects     Project[]          @relation("ProjectMaster")
  projectParticipations ProjectParticipant[]
  priorities           ProjectPriority[]
  comments             Comment[]
  projectReads         ProjectRead[]
  notifications        Notification[]
  savedFilters         SavedFilter[]
  auditLogs            AuditLog[]
  googleConnections     GoogleConnection[]
  createdTasks         TaskItem[]
  joinRequests         PartnerJoinRequest[]
}

model Partner {
  id         String     @id @default(cuid())
  name       String
  visibility Visibility @default(PRIVATE)
  // 비공개 파트너를 미참여자 목록에도 띄울지. true면 카드는 보이지만 내부 프로젝트는
  // 참여 승인 후에만 볼 수 있다. false면 참여자·관리자 외에는 존재 자체가 안 보인다.
  discoverable Boolean @default(false)
  deletedAt      DateTime? // 소프트 삭제(보관함/휴지통). 총관리자·owner가 복구하거나 영구 삭제할 수 있다.
  color          String? // 대시보드/캘린더/워크플로우에서 파트너를 구분하는 색상
  ownerId        String
  owner          User       @relation("PartnerOwner", fields: [ownerId], references: [id])
  createdAt      DateTime   @default(now())
  lastActivityAt DateTime   @default(now()) // 대시보드 "최근 활동순" 정렬용. 하위 프로젝트가 바뀔 때마다 갱신한다.

  members  PartnerMember[]
  projects Project[]
  hiddenBy PartnerHide[] // 이 파트너를 숨긴 사용자들 (D2)
  pinnedBy PartnerPin[] // 이 파트너를 즐겨찾기 고정한 사용자들
  chatRoom     ChatRoom?
  joinRequests PartnerJoinRequest[]

  @@index([ownerId])
}

// '업무 참여하기' 요청. 아무 계정이나 참여를 신청할 수 있고, 파트너 관리자가 수락/거부한다.
// 거부 이력도 남겨야 같은 사람이 무한정 다시 신청하는지 알 수 있으므로 행을 지우지 않고
// status만 바꾼다(재신청은 PENDING으로 되돌린다).
model PartnerJoinRequest {
  partnerId   String
  userId      String
  status      String    @default("PENDING") // PENDING | ACCEPTED | REJECTED
  createdAt   DateTime  @default(now())
  respondedAt DateTime?
  partner     Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([partnerId, userId])
  @@index([userId])
}

model PartnerMember {
  partnerId String
  userId    String
  role      PartnerRole @default(MEMBER)
  partner   Partner     @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([partnerId, userId])
  // PK가 (partnerId, userId)라 userId 단독 조회(내가 속한 파트너 찾기)는 PK를 쓸 수 없다.
  @@index([userId])
}

// 파트너 숨김은 총관리자 전역 설정이 아니라 계정별 개인 설정이다(D2). 켜고 끄는 것은
// 대시보드 표시 여부에만 영향을 주고, 다른 사용자의 화면에는 영향을 주지 않는다.
model PartnerHide {
  userId    String
  partnerId String
  hiddenAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@id([userId, partnerId])
  @@index([partnerId])
}

// 파트너 즐겨찾기(대시보드 상단 고정). 사람마다 보고 싶은 파트너가 다르므로 개인별 테이블.
model PartnerPin {
  userId    String
  partnerId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@id([userId, partnerId])
  @@index([partnerId])
}

// 채팅방. 파트너방은 파트너당 하나(멤버십을 PartnerMember에서 그대로 물려받는다),
// 1:1과 단체방은 ChatRoomMember로 참여자를 직접 관리한다. 단체방 생성·초대·강퇴는
// 무분별한 방 증식을 막기 위해 총관리자만 할 수 있다.
model ChatRoom {
  id          String       @id @default(cuid())
  kind        ChatRoomKind
  partnerId   String?      @unique // PARTNER 방 전용
  name        String? // GROUP 방 전용
  // 1:1 방 중복 생성 방지용 키. 두 사용자 id를 정렬해 이어붙인다.
  directKey   String?      @unique
  createdById String?
  createdAt   DateTime     @default(now())

  partner   Partner?         @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  createdBy User?            @relation("ChatRoomCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members   ChatRoomMember[]
  messages  ChatMessage[]
  reads     ChatRead[]
}

enum ChatRoomKind {
  PARTNER
  DIRECT
  GROUP
}

// DIRECT·GROUP 방의 참여자. PARTNER 방은 여기에 행을 만들지 않는다 —
// 파트너 멤버가 바뀔 때마다 두 곳을 맞춰야 하는 문제를 만들지 않기 위해서다.
model ChatRoomMember {
  roomId   String
  userId   String
  joinedAt DateTime @default(now())
  room     ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
  @@index([userId])
}

model ChatMessage {
  id        String    @id @default(cuid())
  roomId    String
  authorId  String
  body      String
  createdAt DateTime  @default(now())
  editedAt  DateTime? // 수정 시각. 원본과 구분해 "(수정됨)"을 붙이는 용도
  deletedAt DateTime? // 소프트 삭제 — 인용 답장이 가리키는 원본이 사라지지 않게 한다
  replyToId String?

  room      ChatRoom       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  author    User           @relation(fields: [authorId], references: [id])
  replyTo   ChatMessage?   @relation("ChatReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   ChatMessage[]  @relation("ChatReply")
  reactions ChatReaction[]

  // 목록은 항상 방으로 좁힌 뒤 시간순으로 읽는다.
  @@index([roomId, createdAt])
  @@index([authorId])
}

// 이모지 리액션. "확인했습니다" 한 줄을 대신해 알림 소음을 줄인다.
model ChatReaction {
  messageId String
  userId    String
  emoji     String
  createdAt DateTime    @default(now())
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId, emoji])
  @@index([messageId])
}

// 안읽음 뱃지와 '여기까지 읽음' 마커, 읽은 사람 표시의 기준. ProjectRead와 같은 모양이다.
model ChatRead {
  roomId String
  userId String
  // @updatedAt을 쓰지 않는다: Prisma의 upsert는 update가 비어 있으면 UPDATE 자체를
  // 건너뛰어 @updatedAt이 갱신되지 않는다. 읽음 시각은 항상 명시적으로 넣는다.
  lastReadAt DateTime
  room       ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
  @@index([userId])
}

// 웹 푸시 구독. 사람마다 기기·브라우저별로 여러 개를 가질 수 있다.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Project {
  id          String        @id @default(cuid())
  partnerId   String
  parentId    String? // 트리: 부모 1 (동일 파트너 내)
  title       String
  memo        String?
  links       String[] // 참고 링크. 순서만 있으면 되므로 별도 테이블 대신 배열 컬럼.
  status      ProjectStatus @default(TODO)
  visibility  Visibility    @default(PUBLIC)
  masterId    String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt // 미확인 표시 판정 기준(제목/메모/기한 등 수정 감지)
  dueDate     DateTime?
  completedAt DateTime?
  deletedAt   DateTime? // 소프트 삭제(보관함/휴지통). 삭제 시 하위 트리 전체를 함께 보관한다(D3).
  canvasX     Float?
  canvasY     Float? // 워크플로우에서 드래그로 옮긴 위치. 없으면 dagre 자동배치 사용.
  recurrence  String? // "WEEKLY" | null. 완료 시 다음 회차를 자동 생성.

  // 구글 캘린더 연동(G). startDate는 구글 장기 일정을 업무로 전환할 때만 채워지고
  // 생성·수정 UI에는 노출하지 않는다 — 없으면 지금처럼 dueDate 기준으로만 표시.
  startDate           DateTime?
  googleEventId       String? // 이 업무를 구글 보조 캘린더로 내보낸 이벤트 id (수정·삭제 매칭용)
  sourceGoogleEventId String? // 구글 일정을 전환해 만든 경우 그 원본 이벤트 id (중복 전환 방지)

  partner      Partner             @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  parent       Project?            @relation("ProjectTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Project[]           @relation("ProjectTree")
  master       User                @relation("ProjectMaster", fields: [masterId], references: [id])
  participants ProjectParticipant[]
  priorities   ProjectPriority[]
  comments     Comment[]
  reads        ProjectRead[]
  tasks        TaskItem[]
  pins         ProjectPin[]

  // 목록 조회는 항상 partnerId로 좁힌 뒤 createdAt으로 정렬하므로 복합 인덱스로 둘 다 태운다.
  @@index([partnerId, createdAt])
  @@index([parentId])
  @@index([masterId])
  @@index([sourceGoogleEventId])
}

// 프로젝트 카드 상단 고정. PartnerPin과 같이 계정별 개인 설정이라 별도 테이블.
// 프로젝트가 완료되면 고정을 풀어야 하므로 completeProject에서 이 행들을 지운다.
model ProjectPin {
  userId    String
  projectId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@index([projectId])
}

model ProjectParticipant {
  projectId      String
  userId         String
  includeSubtree Boolean         @default(true) // false = '해당 프로젝트만 공유'
  role           ParticipantRole @default(MEMBER) // VIEWER는 조회·코멘트만 가능(D4)
  joinedAt       DateTime        @default(now())
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

model ProjectPriority {
  // 참여자별 우선순위
  projectId String
  userId    String
  level     Priority @default(HOLD)
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

// 사용자별로 프로젝트를 마지막으로 본 시각. 카드의 "미확인" 빨간 점 판정에 쓴다.
model ProjectRead {
  projectId  String
  userId     String
  // @updatedAt을 쓰지 않는다: Prisma의 upsert는 update가 비어 있으면 UPDATE 자체를
  // 건너뛰어 @updatedAt이 갱신되지 않는다(scripts/check-project-read.ts로 확인).
  // 그 탓에 한 번 읽은 프로젝트는 lastReadAt이 그대로 멈춰, 이후 수정·코멘트가 생겨도
  // 미확인 빨간 점이 사라지지 않았다. 읽음 시각은 항상 명시적으로 넣는다.
  lastReadAt DateTime
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

// 프로젝트 안의 체크리스트 항목(구글 Tasks/애플 미리알림 스타일). 담당자 개념 없이
// 프로젝트 참여자 누구나 추가·체크·삭제할 수 있는 공유 할 일 목록이다.
// 모델명이 TaskItem인 이유: D1 리네임(Task→Project) 당시 Postgres가 인덱스/제약 이름까지
// 자동으로 바꿔주지 않아 "Task_pkey" 등 옛 이름이 지금도 Project 테이블에 붙어 있다.
// 순수 "Task"로 만들면 그 좀비 인덱스 이름과 충돌한다.
model TaskItem {
  id          String    @id @default(cuid())
  projectId   String
  title       String
  done        Boolean   @default(false)
  createdById String
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id])

  @@index([projectId, createdAt])
}

model Comment {
  id        String   @id @default(cuid())
  projectId String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])

  // 코멘트 수 집계와 "최신 1건" 조회가 프로젝트 목록마다 돌므로 정렬 컬럼까지 묶는다.
  @@index([projectId, createdAt])
  @@index([authorId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  refId     String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 알림 목록은 내 것만 최신순 20건을 읽는다.
  @@index([userId, createdAt])
}

model SavedFilter {
  id        String   @id @default(cuid())
  userId    String
  name      String
  query     String // 쿼리스트링 그대로 저장 (예: "partnerId=...&status=IN_PROGRESS")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// 되돌리기 어려운 조작(master 위임, 하드 삭제)만 기록. 대상이 삭제돼도 로그는 남아야 하므로
// targetId는 참조가 아닌 문자열로만 보관한다.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String
  targetId   String
  partnerId  String?
  message    String
  createdAt  DateTime @default(now())
  actor      User     @relation(fields: [actorId], references: [id])

  @@index([partnerId, createdAt])
  @@index([actorId])
}

// 시스템 전역 설정. 항상 단일 행만 존재한다(없으면 코드에서 기본값 사용).
model AppSetting {
  id                  String @id @default(cuid())
  commentVisibleCount Int    @default(5)
}

// 회사 공용 구글 계정 연동. AppSetting처럼 항상 단일 행만 존재한다(연결 안 됨 = 행 없음).
// 총관리자만 연결·해제할 수 있다. 토큰은 평문 저장하지 않고 GOOGLE_TOKEN_KEY로 암호화한다.
model GoogleConnection {
  id             String   @id @default(cuid())
  googleEmail    String
  accessToken    String
  refreshToken   String
  expiresAt      DateTime
  scope          String
  syncCalendarId String? // 웹앱 업무를 내보내는 보조 캘린더("AR_PM 업무") id
  enabledCalendarIds String[] @default([]) // 캘린더 뷰에 표시할 캘린더로 관리자가 고른 id 목록
  connectedById  String
  connectedAt    DateTime @default(now())
  connectedBy    User     @relation(fields: [connectedById], references: [id])
}

enum Visibility {
  PUBLIC
  PRIVATE
}

enum PartnerRole {
  OWNER
  MEMBER
}

// VIEWER는 프로젝트를 보고 코멘트를 달 수만 있다 — 수정·삭제·상태 변경·상위 이동 불가(D4).
enum ParticipantRole {
  MEMBER
  VIEWER
}

enum ProjectStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum Priority {
  URGENT
  NORMAL
  HOLD
}
